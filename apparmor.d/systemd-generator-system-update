abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{lib}/systemd/system-generators/systemd-system-update-generator
@{att} = /att/systemd-generator-system-update/
profile systemd-generator-system-update /{,usr/}lib{,exec,32,64}/systemd/system-generators/systemd-system-update-generator flags=(attach_disconnected,attach_disconnected.path=@{att},complain) {
  include <abstractions/attached/base>
  include <abstractions/common/systemd>

  ptrace read peer=@{p_systemd},

  @{exec_path} mr,

  @{PROC}/@{pids}/cgroup r,
  @{PROC}/@{pids}/status r,

  include if exists <local/systemd-generator-system-update>
}

# vim:syntax=apparmor
