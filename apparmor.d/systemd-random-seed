abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{lib}/systemd/systemd-random-seed
@{att} = /att/systemd-random-seed/
profile systemd-random-seed /{,usr/}lib{,exec,32,64}/systemd/systemd-random-seed flags=(attach_disconnected,attach_disconnected.path=@{att},complain) {
  include <abstractions/attached/base>
  include <abstractions/common/systemd>

  capability net_admin,

  ptrace read peer=@{p_systemd},

  @{exec_path} mr,

  /etc/machine-id r,

  /var/lib/ w,
  /var/lib/systemd/ rw,
  /var/lib/systemd/random-seed rw,

  @{PROC}/sys/kernel/random/poolsize r,

  /dev/urandom w,

  include if exists <local/systemd-random-seed>
}

# vim:syntax=apparmor
