abi <abi/4.0>,

include <tunables/global>

@{name} = Mullvad?VPN mullvad-vpn
@{domain} = org.chromium.Chromium
@{lib_dirs} = /opt/@{name} @{lib}/@{name}
@{config_dirs} = @{user_config_dirs}/@{name}
@{cache_dirs} = @{user_cache_dirs}/@{name}

@{exec_path} = @{lib_dirs}/mullvad-gui @{bin}/mullvad-vpn
@{att} = /att/mullvad-gui/
profile mullvad-gui /{opt/Mullvad?VPN/mullvad-gui,opt/mullvad-vpn/mullvad-gui,{,usr/}lib{,exec,32,64}/Mullvad?VPN/mullvad-gui,{,usr/}lib{,exec,32,64}/mullvad-vpn/mullvad-gui,{,usr/}bin/mullvad-vpn} flags=(attach_disconnected,attach_disconnected.path=@{att},complain) {
  include <abstractions/attached/base>
  include <abstractions/bus-system>
  include <abstractions/common/electron>
  include <abstractions/ibus-strict>

  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,
  network netlink raw,

  unix (send receive) type=stream peer=(label=gsettings),

  dbus send bus=system path=/org/freedesktop/login1
       interface=org.freedesktop.login1.Manager
       member=Inhibit
       peer=(name=org.freedesktop.login1, label=systemd-logind),

  @{exec_path} mrix,
  @{bin}/gsettings px,
  @{bin}/mullvad-exclude px,

  @{open_path} px -> child-open-browsers,

  owner @{user_config_dirs}/autostart/mullvad-vpn.desktop rw,

  @{run}/mullvad-vpn rw,

  /dev/tty rw,

  include if exists <local/mullvad-gui>
}

# vim:syntax=apparmor
