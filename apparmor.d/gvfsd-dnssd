abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{lib}/{,gvfs/}gvfsd-dnssd
@{att} = ""
profile gvfsd-dnssd /{,usr/}lib{,exec,32,64}/{,gvfs/}gvfsd-dnssd flags=(complain) {
  include <abstractions/base-strict>
  include <abstractions/avahi-observe>
  include <abstractions/bus-session>
  include <abstractions/bus-system>
  include <abstractions/gvfs-backend>

  #aa/dbus own bus=session name=org.gtk.vfs.mountpoint_dnssd
  include <abstractions/bus/session/own>
  dbus bind bus=session name=org.gtk.vfs.mountpoint_dnssd{,.*},
  dbus receive bus=session path=/org/gtk/vfs/mountpoint_dnssd{,/**}
       interface=org.gtk.vfs.mountpoint_dnssd{,.*}
       peer=(name="@{busname}"),
  dbus send bus=session path=/org/gtk/vfs/mountpoint_dnssd{,/**}
       interface=org.gtk.vfs.mountpoint_dnssd{,.*}
       peer=(name="{@{busname},org.freedesktop.DBus}"),
  # DBus.Properties: reply to properties request from anyone
  dbus (send receive) bus=session path=/org/gtk/vfs/mountpoint_dnssd{,/**}
       interface=org.freedesktop.DBus.Properties
       member={Get,GetAll,Set,PropertiesChanged}
       peer=(name="{@{busname},org.freedesktop.DBus}"),
  # DBus.Introspectable: allow clients to introspect the service
  dbus receive bus=session path=/org/gtk/vfs/mountpoint_dnssd{,/**}
       interface=org.freedesktop.DBus.Introspectable
       member=Introspect
       peer=(name="@{busname}"),
  # DBus.ObjectManager: allow clients to enumerate sources
  dbus receive bus=session path=/org/gtk/vfs/mountpoint_dnssd{,/**}
       interface=org.freedesktop.DBus.ObjectManager
       member=GetManagedObjects
       peer=(name="{@{busname},org.gtk.vfs.mountpoint_dnssd{,.*}}"),
  dbus send bus=session path=/org/gtk/vfs/mountpoint_dnssd{,/**}
       interface=org.freedesktop.DBus.ObjectManager
       member={InterfacesAdded,InterfacesRemoved}
       peer=(name="{@{busname},org.freedesktop.DBus}"),


  @{exec_path} mr,

  owner @{run}/user/@{uid}/gvfsd/ rw,
  owner @{run}/user/@{uid}/gvfsd/socket-@{rand8} rw,

  include if exists <local/gvfsd-dnssd>
}

# vim:syntax=apparmor
