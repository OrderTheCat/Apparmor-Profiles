abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{bin}/yay
@{att} = /att/yay/
profile yay /{,usr/}bin/yay flags=(attach_disconnected,attach_disconnected.path=@{att},complain) {
  include <abstractions/attached/base>
  include <abstractions/attached/consoles>
  include <abstractions/golang-strict>
  include <abstractions/attached/nameservice-strict>
  include <abstractions/ssl_certs>

  network inet dgram,
  network inet6 dgram,
  network inet stream,
  network inet6 stream,
  network netlink raw,

  signal send set=term peer=pkttyagent,
  signal send set=term peer=systemd-tty-ask-password-agent,

  @{exec_path} mr,

  @{editor_path}      cx -> editor,
  @{bin}/git          cx -> git,
  @{bin}/gpg{,2}      cx -> gpg,
  @{bin}/makepkg      px,
  @{bin}/pacman       px,
  @{bin}/pacman-conf  px,
  @{bin}/sudo         cx -> sudo,
  @{bin}/pkttyagent   px,
  @{bin}/systemd-tty-ask-password-agent px,

  /var/lib/pacman/** r,

  owner @{user_cache_dirs}/yay/ rw,
  owner @{user_cache_dirs}/yay/** rwkl -> @{user_cache_dirs}/yay/**,

  owner @{user_config_dirs}/yay/{,**} rw,

  owner @{PROC}/@{pid}/stat r,

  profile git flags=(attach_disconnected,attach_disconnected.path=@{att},complain) {
    include <abstractions/attached/base>
    include <abstractions/attached/consoles>
    include <abstractions/attached/nameservice-strict>
    include <abstractions/ssl_certs>

    network inet dgram,
    network inet6 dgram,
    network inet stream,
    network inet6 stream,
    network netlink raw,

    @{bin}/git*              mrix,
    @{lib}/git{,-core}/git*  mrix,

    @{pager_path}   rpx -> child-pager,
    @{bin}/gpg{2,}  rpx -> yay//gpg,

    /usr/share/git{,-core}/{,**} r,

    owner @{user_build_dirs}/**/.git/** r,
    owner @{user_pkg_dirs}/**/.git/** r,
    owner @{user_projects_dirs}/**/.git/** r,

    owner @{HOME}/.gitconfig r,
    owner @{user_cache_dirs}/yay/ rw,
    owner @{user_cache_dirs}/yay/** rwlk -> @{user_cache_dirs}/yay/**,
    owner @{user_config_dirs}/git/{,*} r,

    include if exists <local/yay_git>
  }

  profile editor flags=(attach_disconnected,attach_disconnected.path=@{att},complain) {
    include <abstractions/attached/base>
    include <abstractions/app/editor>

    owner @{HOME}/**/ r, # For pwd

    owner @{user_cache_dirs}/yay/*/** rw,

    include if exists <local/yay_editor>
  }

  profile gpg flags=(attach_disconnected,attach_disconnected.path=@{att},complain) {
    include <abstractions/attached/base>
    include <abstractions/attached/consoles>

    @{bin}/gpg{,2}     mr,
    @{bin}/gpg-agent  rpx,
    @{bin}/dirmngr    rpx,

    owner @{HOME}/@{XDG_GPG_DIR}/ rw,
    owner @{HOME}/@{XDG_GPG_DIR}/** rwkl -> @{HOME}/@{XDG_GPG_DIR}/**,

    owner @{run}/user/@{uid}/gnupg/d.@{hex}/S.dirmngr rw,
    owner @{run}/user/@{uid}/gnupg/d.@{hex}/S.gpg-agent rw,

    owner @{PROC}/@{pid}/fd/ r,

    include if exists <local/yay_gpg>
  }

  profile sudo flags=(attach_disconnected,attach_disconnected.path=@{att},complain) {
    include <abstractions/attached/base>
    include <abstractions/app/sudo>

    capability sys_ptrace,

    ptrace read peer=unconfined,

    @{bin}/pacman px,

    include if exists <local/yay_sudo>
  }

  include if exists <local/yay>
}

# vim:syntax=apparmor
