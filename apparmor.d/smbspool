abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{bin}/smbspool
@{att} = ""
profile smbspool /{,usr/}bin/smbspool flags=(complain) {
  include <abstractions/base-strict>

  @{exec_path} mr,

  /etc/papersize r,

  include if exists <local/smbspool>
}

# vim:syntax=apparmor
