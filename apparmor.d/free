abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{bin}/free
@{att} = /att/free/
profile free /{,usr/}bin/free flags=(attach_disconnected,attach_disconnected.path=@{att},complain) {
  include <abstractions/attached/base>
  include <abstractions/attached/consoles>

  @{exec_path} mr,

  include if exists <local/free>
}

# vim:syntax=apparmor
