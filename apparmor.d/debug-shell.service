# systemd service: `debug-shell.service`
#
# ```sh
# /usr/bin/bash
# ```
#
# On purpose, this profile allow everything.

abi <abi/4.0>,

include <tunables/global>

@{att} = ""
profile debug-shell.service flags=(complain) {
  include <abstractions/base-strict>

  all,

  include if exists <local/debug-shell.service>
}

# vim:syntax=apparmor
