abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{lib}/systemd/system-generators/ostree-system-generator
@{att} = /att/systemd-generator-ostree/
profile systemd-generator-ostree /{,usr/}lib{,exec,32,64}/systemd/system-generators/ostree-system-generator flags=(attach_disconnected,attach_disconnected.path=@{att},complain) {
  include <abstractions/attached/base>

  ptrace read peer=@{p_systemd},

  @{exec_path} mr,

  @{PROC}/cmdline r,

  include if exists <local/systemd-generator-ostree>
}

# vim:syntax=apparmor
