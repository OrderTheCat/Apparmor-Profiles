abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{bin}/keepassxc-cli
@{att} = ""
profile keepassxc-cli /{,usr/}bin/keepassxc-cli flags=(complain) {
  include <abstractions/base-strict>

  @{exec_path} mr,

  include if exists <local/keepassxc-cli>
}

# vim:syntax=apparmor
