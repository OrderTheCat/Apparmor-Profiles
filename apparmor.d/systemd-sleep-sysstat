abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{lib}/systemd/system-sleep/sysstat.sleep
@{att} = ""
profile systemd-sleep-sysstat /{,usr/}lib{,exec,32,64}/systemd/system-sleep/sysstat.sleep flags=(complain) {
  include <abstractions/base-strict>

  @{exec_path} mr,
  @{sh_path} r,

  @{lib}/sysstat/sa{1,2} px,
  @{lib}/sysstat/debian-sa{1,2} px,

  include if exists <local/systemd-sleep-sysstat>
}

# vim:syntax=apparmor
