abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{sbin}/swapon @{sbin}/swapoff
@{att} = ""
profile swapon /{{,usr/}{,s}bin/swapon,{,usr/}{,s}bin/swapoff} flags=(complain) {
  include <abstractions/base-strict>
  include <abstractions/disks-write>

  capability sys_admin,
  capability sys_resource,

  @{exec_path} mr,

  /etc/fstab r,

  owner /swap.img rw,
  owner /swap/swapfile rw,
  owner /swapfile rw,

  @{PROC}/swaps r,
  @{PROC}/@{pid}/oom_score_adj w,

  /dev/pts/@{u16} rw,

  include if exists <local/swapon>
}

# vim:syntax=apparmor
