# systemd service: `cloud-init-hotplugd.service`
#
# ```sh
# /bin/bash -c 'read args <&3; echo "args=$args"; \
#                         exec /usr/bin/cloud-init devel hotplug-hook $args; \
#                         exit 0'
# ```

abi <abi/4.0>,

include <tunables/global>

@{att} = ""
profile cloud-init-hotplugd.service flags=(complain) {
  include <abstractions/base-strict>

  @{sh_path}         ix,
  @{bin}/cloud-init  px,

  include if exists <local/cloud-init-hotplugd.service>
}

# vim:syntax=apparmor
