abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{lib}/gnome-remote-desktop-daemon
@{att} = ""
profile gnome-remote-desktop-daemon /{,usr/}lib{,exec,32,64}/gnome-remote-desktop-daemon flags=(complain) {
  include <abstractions/base-strict>
  include <abstractions/bus/system/org.freedesktop.PolicyKit1>
  include <abstractions/dconf-write>
  include <abstractions/gnome-strict>
  include <abstractions/graphics>
  include <abstractions/nameservice-strict>

  network inet dgram,
  network inet stream,
  network inet6 dgram,
  network inet6 stream,
  network netlink raw,

  #aa/dbus own bus=system name=org.gnome.RemoteDesktop
  include <abstractions/bus/system/own>
  dbus bind bus=system name=org.gnome.RemoteDesktop{,.*},
  dbus receive bus=system path=/org/gnome/RemoteDesktop{,/**}
       interface=org.gnome.RemoteDesktop{,.*}
       peer=(name="@{busname}"),
  dbus send bus=system path=/org/gnome/RemoteDesktop{,/**}
       interface=org.gnome.RemoteDesktop{,.*}
       peer=(name="{@{busname},org.freedesktop.DBus}"),
  # DBus.Properties: reply to properties request from anyone
  dbus (send receive) bus=system path=/org/gnome/RemoteDesktop{,/**}
       interface=org.freedesktop.DBus.Properties
       member={Get,GetAll,Set,PropertiesChanged}
       peer=(name="{@{busname},org.freedesktop.DBus}"),
  # DBus.Introspectable: allow clients to introspect the service
  dbus receive bus=system path=/org/gnome/RemoteDesktop{,/**}
       interface=org.freedesktop.DBus.Introspectable
       member=Introspect
       peer=(name="@{busname}"),
  # DBus.ObjectManager: allow clients to enumerate sources
  dbus receive bus=system path=/org/gnome/RemoteDesktop{,/**}
       interface=org.freedesktop.DBus.ObjectManager
       member=GetManagedObjects
       peer=(name="{@{busname},org.gnome.RemoteDesktop{,.*}}"),
  dbus send bus=system path=/org/gnome/RemoteDesktop{,/**}
       interface=org.freedesktop.DBus.ObjectManager
       member={InterfacesAdded,InterfacesRemoved}
       peer=(name="{@{busname},org.freedesktop.DBus}"),

  #aa/dbus talk bus=system name=org.gnome.DisplayManager label=gdm
  # Unix: allow connection to the profile
  unix type=stream peer=(label=gdm),
  # org.gnome.DisplayManager: send and receive anything to the interface on the specific peer label
  dbus (send receive) bus=system path=/org/gnome/DisplayManager{,/**}
       interface=org.gnome.DisplayManager{,.*}
       peer=(name="{@{busname},org.gnome.DisplayManager{,.*},org.freedesktop.DBus}", label=gdm),
  dbus send bus=system path=/org/gnome/DisplayManager{,/**}
       interface=org.gnome.DisplayManager{,.*}
       peer=(name="org.gnome.DisplayManager{,.*}"),
  # DBus.Properties: read and send properties
  dbus (send receive) bus=system path=/org/gnome/DisplayManager{,/**}
       interface=org.freedesktop.DBus.Properties
       member={Get,GetAll,Set,PropertiesChanged}
       peer=(name="{@{busname},org.gnome.DisplayManager{,.*},org.freedesktop.DBus}", label=gdm),
  # DBus.Introspectable: allow service introspection
  dbus send bus=system path=/org/gnome/DisplayManager{,/**}
       interface=org.freedesktop.DBus.Introspectable
       member=Introspect
       peer=(name="{@{busname},org.gnome.DisplayManager{,.*},org.freedesktop.DBus}", label=gdm),
  # DBus.ObjectManager: allow clients to enumerate sources
  dbus send bus=system path=/org/gnome/DisplayManager{,/**}
       interface=org.freedesktop.DBus.ObjectManager
       member=GetManagedObjects
       peer=(name="{@{busname},org.gnome.DisplayManager{,.*},org.freedesktop.DBus}", label=gdm),
  dbus receive bus=system path=/org/gnome/DisplayManager{,/**}
       interface=org.freedesktop.DBus.ObjectManager
       member={InterfacesAdded,InterfacesRemoved}
       peer=(name="{@{busname},org.gnome.DisplayManager{,.*},org.freedesktop.DBus}", label=gdm),


  @{exec_path} mr,

  /usr/share/gnome-remote-desktop/{,**} r,

  owner /var/lib/gnome-remote-desktop//{,**} r,

  include if exists <local/gnome-remote-desktop-daemon>
}

# vim:syntax=apparmor
