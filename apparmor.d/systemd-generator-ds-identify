abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{lib}/cloud-init/ds-identify
@{att} = /att/systemd-generator-ds-identify/
profile systemd-generator-ds-identify /{,usr/}lib{,exec,32,64}/cloud-init/ds-identify flags=(attach_disconnected,attach_disconnected.path=@{att},complain) {
  include <abstractions/attached/base>
  include <abstractions/attached/consoles>
  include <abstractions/attached/nameservice-strict>
  include <abstractions/sys/dmi-full>

  ptrace read peer=@{p_systemd},

  @{exec_path} mr,

  @{sh_path}                     rix,
  @{bin}/{,e}grep                rix,
  @{bin}/systemd-detect-virt     rpx,
  @{bin}/tr                      rix,
  @{bin}/uname                   rix,
  @{sbin}/blkid                  rpx,

  /etc/cloud/{,**} r,

  @{run}/cloud-init/{,.}ds-identify.* rw,
  @{run}/cloud-init/cloud.cfg rw,

  @{sys}/class/*/ r,
  @{sys}/devices/**/name r,

  @{PROC}/cmdline r,
  @{PROC}/uptime r,
  @{PROC}/@{pid}/environ r,

  include if exists <local/systemd-generator-ds-identify>
}


# vim:syntax=apparmor
