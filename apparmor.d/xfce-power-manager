abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{bin}/xfce4-power-manager
@{att} = /att/xfce-power-manager/
profile xfce-power-manager /{,usr/}bin/xfce4-power-manager flags=(attach_disconnected,attach_disconnected.path=@{att},complain) {
  include <abstractions/attached/base>
  include <abstractions/fontconfig-cache-read>
  include <abstractions/bus-session>
  include <abstractions/xfce>
  include <abstractions/attached/nameservice-strict>

  #aa/dbus own bus=session name=org.xfce.PowerManager
  include <abstractions/bus/session/own>
  dbus bind bus=session name=org.xfce.PowerManager{,.*},
  dbus receive bus=session path=/org/xfce/PowerManager{,/**}
       interface=org.xfce.PowerManager{,.*}
       peer=(name="@{busname}"),
  dbus send bus=session path=/org/xfce/PowerManager{,/**}
       interface=org.xfce.PowerManager{,.*}
       peer=(name="{@{busname},org.freedesktop.DBus}"),
  # DBus.Properties: reply to properties request from anyone
  dbus (send receive) bus=session path=/org/xfce/PowerManager{,/**}
       interface=org.freedesktop.DBus.Properties
       member={Get,GetAll,Set,PropertiesChanged}
       peer=(name="{@{busname},org.freedesktop.DBus}"),
  # DBus.Introspectable: allow clients to introspect the service
  dbus receive bus=session path=/org/xfce/PowerManager{,/**}
       interface=org.freedesktop.DBus.Introspectable
       member=Introspect
       peer=(name="@{busname}"),
  # DBus.ObjectManager: allow clients to enumerate sources
  dbus receive bus=session path=/org/xfce/PowerManager{,/**}
       interface=org.freedesktop.DBus.ObjectManager
       member=GetManagedObjects
       peer=(name="{@{busname},org.xfce.PowerManager{,.*}}"),
  dbus send bus=session path=/org/xfce/PowerManager{,/**}
       interface=org.freedesktop.DBus.ObjectManager
       member={InterfacesAdded,InterfacesRemoved}
       peer=(name="{@{busname},org.freedesktop.DBus}"),

  #aa/dbus own bus=session name=org.freedesktop.PowerManagement
  dbus bind bus=session name=org.freedesktop.PowerManagement{,.*},
  dbus receive bus=session path=/org/freedesktop/PowerManagement{,/**}
       interface=org.freedesktop.PowerManagement{,.*}
       peer=(name="@{busname}"),
  dbus send bus=session path=/org/freedesktop/PowerManagement{,/**}
       interface=org.freedesktop.PowerManagement{,.*}
       peer=(name="{@{busname},org.freedesktop.DBus}"),
  # DBus.Properties: reply to properties request from anyone
  dbus (send receive) bus=session path=/org/freedesktop/PowerManagement{,/**}
       interface=org.freedesktop.DBus.Properties
       member={Get,GetAll,Set,PropertiesChanged}
       peer=(name="{@{busname},org.freedesktop.DBus}"),
  # DBus.Introspectable: allow clients to introspect the service
  dbus receive bus=session path=/org/freedesktop/PowerManagement{,/**}
       interface=org.freedesktop.DBus.Introspectable
       member=Introspect
       peer=(name="@{busname}"),
  # DBus.ObjectManager: allow clients to enumerate sources
  dbus receive bus=session path=/org/freedesktop/PowerManagement{,/**}
       interface=org.freedesktop.DBus.ObjectManager
       member=GetManagedObjects
       peer=(name="{@{busname},org.freedesktop.PowerManagement{,.*}}"),
  dbus send bus=session path=/org/freedesktop/PowerManagement{,/**}
       interface=org.freedesktop.DBus.ObjectManager
       member={InterfacesAdded,InterfacesRemoved}
       peer=(name="{@{busname},org.freedesktop.DBus}"),


  @{exec_path} mr,

  @{bin}/xfpm-power-backlight-helper rpx,

  /etc/xdg/autostart/xfce4-power-manager.desktop r,

  owner @{PROC}/@{pid}/cgroup r,
  owner @{PROC}/@{pid}/stat r,

  @{att}@{run}/systemd/inhibit/@{int}.ref rw,

  include if exists <local/xfce-power-manager>
}

# vim:syntax=apparmor
