abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{lib}/systemd/systemd-nsresourcework
@{att} = /att/systemd-nsresourcework/
profile systemd-nsresourcework /{,usr/}lib{,exec,32,64}/systemd/systemd-nsresourcework flags=(attach_disconnected,attach_disconnected.path=@{att},complain) {
  include <abstractions/attached/base>

  capability net_admin,
  capability sys_resource,

  signal send set=usr2 peer=systemd-nsresourced,

  @{exec_path} mr,

  @{run}/systemd/nsresource/registry/ r,

  include if exists <local/systemd-nsresourcework>
}

# vim:syntax=apparmor
