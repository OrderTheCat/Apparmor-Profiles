abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{sbin}/dmeventd
@{att} = ""
profile dmeventd /{,usr/}{,s}bin/dmeventd flags=(complain) {
  include <abstractions/base-strict>

  @{exec_path} rm,

  include if exists <local/dmeventd>
}

# vim:syntax=apparmor
