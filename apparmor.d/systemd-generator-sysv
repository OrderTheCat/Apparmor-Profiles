abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{lib}/systemd/system-generators/systemd-sysv-generator
@{att} = /att/systemd-generator-sysv/
profile systemd-generator-sysv /{,usr/}lib{,exec,32,64}/systemd/system-generators/systemd-sysv-generator flags=(attach_disconnected,attach_disconnected.path=@{att},complain) {
  include <abstractions/attached/base>

  capability mknod, # optional: no audit

  ptrace read peer=@{p_systemd},

  @{exec_path} mr,

  /etc/init.d/{,**} r,
  /etc/rc@{int}.d/{,**} r,

  @{run}/systemd/generator.late/** w,

  @{PROC}/@{pid}/cgroup r,
  @{PROC}/1/environ r,
  @{PROC}/cmdline r,
  @{PROC}/sys/kernel/osrelease r,

  /dev/kmsg w,

  include if exists <local/systemd-generator-sysv>
}

# vim:syntax=apparmor
