abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{sbin}/fsck.btrfs
@{att} = ""
profile fsck.btrfs /{,usr/}{,s}bin/fsck.btrfs flags=(complain) {
  include <abstractions/base-strict>

  @{exec_path} r,

  @{sh_path}        rix,

  /etc/fstab r,
  /etc/nsswitch.conf r,
  /etc/passwd r,

  /dev/tty rw,

  include if exists <local/fsck.btrfs>
}

# vim:syntax=apparmor
