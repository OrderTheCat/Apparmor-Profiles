abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{bin}/wl-{copy,paste}
@{att} = /att/wl-copy/
profile wl-copy /{,usr/}bin/wl-{copy,paste} flags=(attach_disconnected,attach_disconnected.path=@{att},complain) {
  include <abstractions/attached/base>
  include <abstractions/attached/consoles>

  @{exec_path} mr,

  @{bin}/cat rix,
  @{bin}/rm  rix,

  @{bin}/cliphist rpux,
  @{bin}/xdg-mime rpx,

  owner @{tmp}/wl-copy-buffer-*/{,**} rw,

  /dev/tty rw,

  include if exists <local/wl-copy>
}

# vim:syntax=apparmor
