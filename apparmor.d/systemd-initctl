abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{lib}/systemd/systemd-initctl
@{att} = /att/systemd-initctl/
profile systemd-initctl /{,usr/}lib{,exec,32,64}/systemd/systemd-initctl flags=(attach_disconnected,attach_disconnected.path=@{att},complain) {
  include <abstractions/attached/base>
  include <abstractions/bus-system>
  include <abstractions/common/systemd>

  capability net_admin,

  unix type=stream addr=@@{udbus}/bus/systemd-initctl/,

  @{exec_path} mr,

  @{run}/initctl rw,

  include if exists <local/systemd-initctl>
}

# vim:syntax=apparmor
