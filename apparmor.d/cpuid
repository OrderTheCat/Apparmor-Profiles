abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{bin}/cpuid
@{att} = ""
profile cpuid /{,usr/}bin/cpuid flags=(complain) {
  include <abstractions/base-strict>
  include <abstractions/consoles>

  capability mknod,

  @{exec_path} mr,

  /dev/cpu/@{int}/cpuid r,

  owner @{tmp}/cpuid* rw,

  include if exists <local/cpuid>
}

# vim:syntax=apparmor
