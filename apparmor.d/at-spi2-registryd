abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{lib}/{,at-spi2{,-core}/}at-spi2-registryd
@{att} = /att/at-spi2-registryd/
profile at-spi2-registryd /{,usr/}lib{,exec,32,64}/{,at-spi2{,-core}/}at-spi2-registryd flags=(attach_disconnected,attach_disconnected.path=@{att},complain) {
  include <abstractions/attached/base>
  include <abstractions/bus-accessibility>
  include <abstractions/bus-session>
  include <abstractions/attached/consoles>
  include <abstractions/session-manager>
  include <abstractions/X-strict>

  signal receive set=term peer=gdm,
  signal receive set=hup  peer=gdm-session-worker,

  #aa/dbus own bus=accessibility name=org.a11y.atspi
  include <abstractions/bus/accessibility/own>
  dbus bind bus=accessibility name=org.a11y.atspi{,.*},
  dbus receive bus=accessibility path=/org/a11y/atspi{,/**}
       interface=org.a11y.atspi{,.*}
       peer=(name="@{busname}"),
  dbus send bus=accessibility path=/org/a11y/atspi{,/**}
       interface=org.a11y.atspi{,.*}
       peer=(name="{@{busname},org.freedesktop.DBus}"),
  # DBus.Properties: reply to properties request from anyone
  dbus (send receive) bus=accessibility path=/org/a11y/atspi{,/**}
       interface=org.freedesktop.DBus.Properties
       member={Get,GetAll,Set,PropertiesChanged}
       peer=(name="{@{busname},org.freedesktop.DBus}"),
  # DBus.Introspectable: allow clients to introspect the service
  dbus receive bus=accessibility path=/org/a11y/atspi{,/**}
       interface=org.freedesktop.DBus.Introspectable
       member=Introspect
       peer=(name="@{busname}"),
  # DBus.ObjectManager: allow clients to enumerate sources
  dbus receive bus=accessibility path=/org/a11y/atspi{,/**}
       interface=org.freedesktop.DBus.ObjectManager
       member=GetManagedObjects
       peer=(name="{@{busname},org.a11y.atspi{,.*}}"),
  dbus send bus=accessibility path=/org/a11y/atspi{,/**}
       interface=org.freedesktop.DBus.ObjectManager
       member={InterfacesAdded,InterfacesRemoved}
       peer=(name="{@{busname},org.freedesktop.DBus}"),

  #aa/dbus talk bus=session name=org.a11y.{B,b}us label="@{p_dbus_accessibility}"
  # Unix: allow connection to the profile
  unix type=stream peer=(label="@{p_dbus_accessibility}"),
  # org.a11y.{B,b}us: send and receive anything to the interface on the specific peer label
  dbus (send receive) bus=session path=/org/a11y/{B,b}us{,/**}
       interface=org.a11y.{B,b}us{,.*}
       peer=(name="{@{busname},org.a11y.{B,b}us{,.*},org.freedesktop.DBus}", label="@{p_dbus_accessibility}"),
  dbus send bus=session path=/org/a11y/{B,b}us{,/**}
       interface=org.a11y.{B,b}us{,.*}
       peer=(name="org.a11y.{B,b}us{,.*}"),
  # DBus.Properties: read and send properties
  dbus (send receive) bus=session path=/org/a11y/{B,b}us{,/**}
       interface=org.freedesktop.DBus.Properties
       member={Get,GetAll,Set,PropertiesChanged}
       peer=(name="{@{busname},org.a11y.{B,b}us{,.*},org.freedesktop.DBus}", label="@{p_dbus_accessibility}"),
  # DBus.Introspectable: allow service introspection
  dbus send bus=session path=/org/a11y/{B,b}us{,/**}
       interface=org.freedesktop.DBus.Introspectable
       member=Introspect
       peer=(name="{@{busname},org.a11y.{B,b}us{,.*},org.freedesktop.DBus}", label="@{p_dbus_accessibility}"),
  # DBus.ObjectManager: allow clients to enumerate sources
  dbus send bus=session path=/org/a11y/{B,b}us{,/**}
       interface=org.freedesktop.DBus.ObjectManager
       member=GetManagedObjects
       peer=(name="{@{busname},org.a11y.{B,b}us{,.*},org.freedesktop.DBus}", label="@{p_dbus_accessibility}"),
  dbus receive bus=session path=/org/a11y/{B,b}us{,/**}
       interface=org.freedesktop.DBus.ObjectManager
       member={InterfacesAdded,InterfacesRemoved}
       peer=(name="{@{busname},org.a11y.{B,b}us{,.*},org.freedesktop.DBus}", label="@{p_dbus_accessibility}"),


  dbus receive bus=session
       interface=org.freedesktop.DBus.Introspectable
       member=Introspect
       peer=(name=@{busname}, label="{gnome-shell,gnome-extension}"),

  @{exec_path} mr,

  include if exists <local/at-spi2-registryd>
}

# vim:syntax=apparmor
