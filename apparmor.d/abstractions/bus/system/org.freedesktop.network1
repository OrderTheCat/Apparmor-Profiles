  abi <abi/4.0>,

  #aa/dbus see bus=system name=org.freedesktop.network1 label="@{p_systemd_networkd}"

  # Unix: allow connection to the profile
  unix type=stream peer=(label="@{p_systemd_networkd}"),

  # DBus.Properties: read all properties from the interface

  dbus send bus=system path=/org/freedesktop/network1{,/**}
       interface=org.freedesktop.DBus.Properties
       member={Get,GetAll}
       peer=(name="{@{busname},org.freedesktop.network1{,.*}}", label="@{p_systemd_networkd}"),

  # DBus.Properties: receive property changed events

  dbus receive bus=system path=/org/freedesktop/network1{,/**}
       interface=org.freedesktop.DBus.Properties
       member=PropertiesChanged
       peer=(name="{@{busname},org.freedesktop.network1{,.*}}", label="@{p_systemd_networkd}"),

  # DBus.Introspectable: allow service introspection

  dbus send bus=system path=/org/freedesktop/network1{,/**}
       interface=org.freedesktop.DBus.Introspectable
       member=Introspect
       peer=(name="{@{busname},org.freedesktop.network1{,.*}}", label="@{p_systemd_networkd}"),

  include if exists <abstractions/bus/system/org.freedesktop.network1.d>

# vim:syntax=apparmor
