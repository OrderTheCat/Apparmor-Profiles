  abi <abi/4.0>,

  #aa/dbus see bus=session name=org.gnome.ArchiveManager1 label="@{p_file_roller}"

  # Unix: allow connection to the profile
  unix type=stream peer=(label="@{p_file_roller}"),

  # DBus.Properties: read all properties from the interface

  dbus send bus=session path=/org/gnome/ArchiveManager1{,/**}
       interface=org.freedesktop.DBus.Properties
       member={Get,GetAll}
       peer=(name="{@{busname},org.gnome.ArchiveManager1{,.*}}", label="@{p_file_roller}"),

  # DBus.Properties: receive property changed events

  dbus receive bus=session path=/org/gnome/ArchiveManager1{,/**}
       interface=org.freedesktop.DBus.Properties
       member=PropertiesChanged
       peer=(name="{@{busname},org.gnome.ArchiveManager1{,.*}}", label="@{p_file_roller}"),

  # DBus.Introspectable: allow service introspection

  dbus send bus=session path=/org/gnome/ArchiveManager1{,/**}
       interface=org.freedesktop.DBus.Introspectable
       member=Introspect
       peer=(name="{@{busname},org.gnome.ArchiveManager1{,.*}}", label="@{p_file_roller}"),

  dbus send bus=session path=/org/gnome/ArchiveManager1
       interface=org.gnome.ArchiveManager1
       member=GetSupportedTypes
       peer=(name=@{busname}, label="@{p_file_roller}"),

  include if exists <abstractions/bus/session/org.gnome.ArchiveManager1.d>

# vim:syntax=apparmor
