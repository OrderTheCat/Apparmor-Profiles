  abi <abi/4.0>,

  #aa/dbus see bus=session name=org.gnome.Nautilus.FileOperations2 label=nautilus

  # Unix: allow connection to the profile
  unix type=stream peer=(label=nautilus),

  # DBus.Properties: read all properties from the interface

  dbus send bus=session path=/org/gnome/Nautilus/FileOperations2{,/**}
       interface=org.freedesktop.DBus.Properties
       member={Get,GetAll}
       peer=(name="{@{busname},org.gnome.Nautilus.FileOperations2{,.*}}", label=nautilus),

  # DBus.Properties: receive property changed events

  dbus receive bus=session path=/org/gnome/Nautilus/FileOperations2{,/**}
       interface=org.freedesktop.DBus.Properties
       member=PropertiesChanged
       peer=(name="{@{busname},org.gnome.Nautilus.FileOperations2{,.*}}", label=nautilus),

  # DBus.Introspectable: allow service introspection

  dbus send bus=session path=/org/gnome/Nautilus/FileOperations2{,/**}
       interface=org.freedesktop.DBus.Introspectable
       member=Introspect
       peer=(name="{@{busname},org.gnome.Nautilus.FileOperations2{,.*}}", label=nautilus),

  include if exists <abstractions/bus/session/org.gnome.Nautilus.FileOperations2.d>

# vim:syntax=apparmor
