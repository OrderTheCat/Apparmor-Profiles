  abi <abi/4.0>,

  #aa/dbus see bus=session name=org.freedesktop.background.Monitor label=xdg-desktop-portal

  # Unix: allow connection to the profile
  unix type=stream peer=(label=xdg-desktop-portal),

  # DBus.Properties: read all properties from the interface

  dbus send bus=session path=/org/freedesktop/background/Monitor{,/**}
       interface=org.freedesktop.DBus.Properties
       member={Get,GetAll}
       peer=(name="{@{busname},org.freedesktop.background.Monitor{,.*}}", label=xdg-desktop-portal),

  # DBus.Properties: receive property changed events

  dbus receive bus=session path=/org/freedesktop/background/Monitor{,/**}
       interface=org.freedesktop.DBus.Properties
       member=PropertiesChanged
       peer=(name="{@{busname},org.freedesktop.background.Monitor{,.*}}", label=xdg-desktop-portal),

  # DBus.Introspectable: allow service introspection

  dbus send bus=session path=/org/freedesktop/background/Monitor{,/**}
       interface=org.freedesktop.DBus.Introspectable
       member=Introspect
       peer=(name="{@{busname},org.freedesktop.background.Monitor{,.*}}", label=xdg-desktop-portal),

  include if exists <abstractions/bus/session/org.freedesktop.background.Monitor.d>

# vim:syntax=apparmor
