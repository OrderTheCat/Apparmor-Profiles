abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{lib}/cockpit/cockpit-tls
@{att} = /att/cockpit-tls/
profile cockpit-tls /{,usr/}lib{,exec,32,64}/cockpit/cockpit-tls flags=(attach_disconnected,attach_disconnected.path=@{att},complain) {
  include <abstractions/attached/base>

  network inet stream,
  network inet6 stream,

  @{exec_path} mr,

  /etc/cockpit/ws-certs.d/{,**} r,

  @{att}@{run}/cockpit/wsinstance/http.sock rw,
  @{att}@{run}/cockpit/wsinstance/https-factory.sock rw,
  @{att}@{run}/cockpit/wsinstance/https@@{hex64}.sock rw,

  owner @{run}/cockpit/tls/{,**} rw,

  include if exists <local/cockpit-tls>
}

# vim:syntax=apparmor
