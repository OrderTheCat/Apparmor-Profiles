abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{bin}/gio-querymodules
@{att} = /att/gio-querymodules/
profile gio-querymodules /{,usr/}bin/gio-querymodules flags=(attach_disconnected,attach_disconnected.path=@{att},complain) {
  include <abstractions/attached/base>
  include <abstractions/attached/consoles>

  capability dac_read_search,
  capability mknod,

  @{exec_path} mr,

  @{lib}/gtk-{3,4}.0/**/giomodule.cache{,.[0-9A-Z]*} w,
  @{lib}/gio/modules/giomodule.cache{,.[0-9A-Z]*} w,

  deny network inet stream,
  deny network inet6 stream,

  include if exists <local/gio-querymodules>
}

# vim:syntax=apparmor
