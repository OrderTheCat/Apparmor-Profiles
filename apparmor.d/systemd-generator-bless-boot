abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{lib}/systemd/system-generators/systemd-bless-boot-generator
@{att} = /att/systemd-generator-bless-boot/
profile systemd-generator-bless-boot /{,usr/}lib{,exec,32,64}/systemd/system-generators/systemd-bless-boot-generator flags=(attach_disconnected,attach_disconnected.path=@{att},complain) {
  include <abstractions/attached/base>
  include <abstractions/common/systemd>

  ptrace read peer=@{p_systemd},

  @{exec_path} mr,

  @{run}/systemd/generator.early/basic.target.wants/ w,
  @{run}/systemd/generator.early/basic.target.wants/systemd-bless-boot.service w,

  @{PROC}/@{pid}/cgroup r,

  include if exists <local/systemd-generator-bless-boot>
}

# vim:syntax=apparmor
