abi <abi/4.0>,

include <tunables/global>

@{lib_dirs} = @{lib}/ /snap/{snapd,core}/{,x}@{int}@{lib}

@{exec_path} = @{lib_dirs}/snapd/snap-discard-ns
@{att} = ""
profile snap-discard-ns /{{,usr/}lib{,exec,32,64}/snapd/snap-discard-ns,snap/{snapd,core}/{,x}[0-9]{[0-9],}{[0-9],}{[0-9],}{[0-9],}{[0-9],}{[0-9],}{[0-9],}{[0-9],}{[0-9],}/{,usr/}lib{,exec,32,64}/snapd/snap-discard-ns} flags=(complain) {
  include <abstractions/base-strict>

  capability setgid,
  capability sys_admin,

  network netlink raw,

  umount @{run}/snapd/ns/*.mnt,

  @{exec_path} mr,
  @{lib_dirs}/**.so* mr,

  / r,
  @{run}/ r,
  @{run}/snapd/ r,
  @{run}/snapd/lock/ r,
  @{run}/snapd/lock/*.lock rwk,
  @{run}/snapd/ns/ r,
  @{run}/snapd/ns/* rw,

  include if exists <local/snap-discard-ns>
}

# vim:syntax=apparmor
