abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{bin}/xembedsniproxy
@{att} = /att/xembedsniproxy/
profile xembedsniproxy /{,usr/}bin/xembedsniproxy flags=(attach_disconnected,attach_disconnected.path=@{att},complain) {
  include <abstractions/attached/base>
  include <abstractions/graphics>
  include <abstractions/kde-strict>
  include <abstractions/attached/nameservice-strict>

  @{exec_path} mr,

  owner @{tmp}/xauth_@{rand6} r,

  owner @{run}/user/@{uid}/iceauth_@{rand6} r,

  @{run}/user/@{uid}/xauth_@{rand6} rl,

  /dev/tty r,

  include if exists <local/xembedsniproxy>
}

# vim:syntax=apparmor
