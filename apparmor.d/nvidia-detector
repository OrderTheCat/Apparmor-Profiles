abi <abi/4.0>,

include <tunables/global>

@{exec_path} =  @{bin}/nvidia-detector
@{att} = ""
profile nvidia-detector /{,usr/}bin/nvidia-detector flags=(complain) {
  include <abstractions/base-strict>

  @{exec_path} mr,

  include if exists <local/nvidia-detector>
}

# vim:syntax=apparmor
