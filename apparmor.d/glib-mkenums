abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{bin}/glib-mkenums
@{att} = ""
profile glib-mkenums /{,usr/}bin/glib-mkenums flags=(complain) {
  include <abstractions/base-strict>

  @{exec_path} mr,

  @{bin}/ r,

  include if exists <local/glib-mkenums>
}

# vim:syntax=apparmor

