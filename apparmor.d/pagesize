abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{bin}/pagesize
@{att} = ""
profile pagesize /{,usr/}bin/pagesize flags=(complain) {
  include <abstractions/base-strict>

  @{exec_path} mr,

  # For HugePages
  @{sys}/kernel/mm/hugepages/ r,

  include if exists <local/pagesize>
}

# vim:syntax=apparmor
