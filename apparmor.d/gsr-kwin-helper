abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{bin}/gsr-kwin-helper
@{att} = ""
profile gsr-kwin-helper /{,usr/}bin/gsr-kwin-helper flags=(complain) {
  include <abstractions/base-strict>

  signal (receive) set=(kill) peer=gsr-ui,

  @{exec_path} r,

  /dev/dri/card@{int} r,

  include if exists <local/gsr-kwin-helper>
}

# vim:syntax=apparmor
