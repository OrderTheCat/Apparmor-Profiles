abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{lib}/{,gvfs/}gvfsd-smb-browse
@{att} = ""
profile gvfsd-smb-browse /{,usr/}lib{,exec,32,64}/{,gvfs/}gvfsd-smb-browse flags=(complain) {
  include <abstractions/base-strict>
  include <abstractions/bus-session>
  include <abstractions/gvfs-backend>
  include <abstractions/dconf-write>
  include <abstractions/gschemas>
  include <abstractions/nameservice-strict>

  network netlink raw,
  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,

  #aa/dbus own bus=session name=org.gtk.vfs.mountpoint_smb_browse
  include <abstractions/bus/session/own>
  dbus bind bus=session name=org.gtk.vfs.mountpoint_smb_browse{,.*},
  dbus receive bus=session path=/org/gtk/vfs/mountpoint_smb_browse{,/**}
       interface=org.gtk.vfs.mountpoint_smb_browse{,.*}
       peer=(name="@{busname}"),
  dbus send bus=session path=/org/gtk/vfs/mountpoint_smb_browse{,/**}
       interface=org.gtk.vfs.mountpoint_smb_browse{,.*}
       peer=(name="{@{busname},org.freedesktop.DBus}"),
  # DBus.Properties: reply to properties request from anyone
  dbus (send receive) bus=session path=/org/gtk/vfs/mountpoint_smb_browse{,/**}
       interface=org.freedesktop.DBus.Properties
       member={Get,GetAll,Set,PropertiesChanged}
       peer=(name="{@{busname},org.freedesktop.DBus}"),
  # DBus.Introspectable: allow clients to introspect the service
  dbus receive bus=session path=/org/gtk/vfs/mountpoint_smb_browse{,/**}
       interface=org.freedesktop.DBus.Introspectable
       member=Introspect
       peer=(name="@{busname}"),
  # DBus.ObjectManager: allow clients to enumerate sources
  dbus receive bus=session path=/org/gtk/vfs/mountpoint_smb_browse{,/**}
       interface=org.freedesktop.DBus.ObjectManager
       member=GetManagedObjects
       peer=(name="{@{busname},org.gtk.vfs.mountpoint_smb_browse{,.*}}"),
  dbus send bus=session path=/org/gtk/vfs/mountpoint_smb_browse{,/**}
       interface=org.freedesktop.DBus.ObjectManager
       member={InterfacesAdded,InterfacesRemoved}
       peer=(name="{@{busname},org.freedesktop.DBus}"),


  @{exec_path} mr,

  /etc/samba/* r,

        /var/cache/samba/ rw,
        /var/lib/samba/** rwk,
  owner /var/cache/samba/gencache.tdb w,

  owner @{run}/samba/ rw,
  owner @{run}/samba/gencache.tdb rwk,
  owner @{run}/user/@{uid}/gvfsd/socket-@{rand8} rw,

  owner @{user_cache_dirs}/samba/ w,
  owner @{user_cache_dirs}/samba/gencache.tdb rwk,

  include if exists <local/gvfsd-smb-browse>
}

# vim:syntax=apparmor
