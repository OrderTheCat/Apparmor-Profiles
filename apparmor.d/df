abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{bin}/df
@{att} = /att/df/
profile df /{,usr/}bin/df flags=(attach_disconnected,attach_disconnected.path=@{att},complain) {
  include <abstractions/attached/base>
  include <abstractions/attached/consoles>

  capability dac_read_search,

  @{exec_path} mr,

  /usr/share/icons/*/index.theme r,

  # For dir stats
  / r,
  /**/ r,

  owner @{PROC}/@{pid}/mountinfo r,

  /dev/ptmx rw,

  # file_inherit
  deny /var/crash/* w,
  deny @{att}@{run}/systemd/inhibit/* w,

  include if exists <local/df>
}

# vim:syntax=apparmor
