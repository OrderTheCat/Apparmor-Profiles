abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{lib}/systemd/system-generators/systemd-debug-generator
@{att} = /att/systemd-generator-debug/
profile systemd-generator-debug /{,usr/}lib{,exec,32,64}/systemd/system-generators/systemd-debug-generator  flags=(attach_disconnected,attach_disconnected.path=@{att},complain) {
  include <abstractions/attached/base>
  include <abstractions/common/systemd>

  ptrace read peer=@{p_systemd},

  @{exec_path} mr,

  @{run}/credentials/@encrypted/ r,
  @{run}/credentials/@system/ r,
  @{run}/systemd/generator.early/systemd-repart.service w,

  @{PROC}/@{pid}/cgroup r,

  include if exists <local/systemd-generator-debug>
}

# vim:syntax=apparmor
