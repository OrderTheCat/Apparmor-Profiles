abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{bin}/timedatectl
@{att} = ""
profile timedatectl /{,usr/}bin/timedatectl flags=(complain) {
  include <abstractions/base-strict>
  include <abstractions/bus-system>
  include <abstractions/consoles>

  capability net_admin,

  signal send set=cont peer=child-pager,

  #aa/dbus talk bus=system name=org.freedesktop.timedate1 label="@{p_systemd_timedated}"
  # Unix: allow connection to the profile
  unix type=stream peer=(label="@{p_systemd_timedated}"),
  # org.freedesktop.timedate1: send and receive anything to the interface on the specific peer label
  dbus (send receive) bus=system path=/org/freedesktop/timedate1{,/**}
       interface=org.freedesktop.timedate1{,.*}
       peer=(name="{@{busname},org.freedesktop.timedate1{,.*},org.freedesktop.DBus}", label="@{p_systemd_timedated}"),
  dbus send bus=system path=/org/freedesktop/timedate1{,/**}
       interface=org.freedesktop.timedate1{,.*}
       peer=(name="org.freedesktop.timedate1{,.*}"),
  # DBus.Properties: read and send properties
  dbus (send receive) bus=system path=/org/freedesktop/timedate1{,/**}
       interface=org.freedesktop.DBus.Properties
       member={Get,GetAll,Set,PropertiesChanged}
       peer=(name="{@{busname},org.freedesktop.timedate1{,.*},org.freedesktop.DBus}", label="@{p_systemd_timedated}"),
  # DBus.Introspectable: allow service introspection
  dbus send bus=system path=/org/freedesktop/timedate1{,/**}
       interface=org.freedesktop.DBus.Introspectable
       member=Introspect
       peer=(name="{@{busname},org.freedesktop.timedate1{,.*},org.freedesktop.DBus}", label="@{p_systemd_timedated}"),
  # DBus.ObjectManager: allow clients to enumerate sources
  dbus send bus=system path=/org/freedesktop/timedate1{,/**}
       interface=org.freedesktop.DBus.ObjectManager
       member=GetManagedObjects
       peer=(name="{@{busname},org.freedesktop.timedate1{,.*},org.freedesktop.DBus}", label="@{p_systemd_timedated}"),
  dbus receive bus=system path=/org/freedesktop/timedate1{,/**}
       interface=org.freedesktop.DBus.ObjectManager
       member={InterfacesAdded,InterfacesRemoved}
       peer=(name="{@{busname},org.freedesktop.timedate1{,.*},org.freedesktop.DBus}", label="@{p_systemd_timedated}"),

  #aa/dbus talk bus=system name=org.freedesktop.timesync1 label=systemd-timesyncd
  # Unix: allow connection to the profile
  unix type=stream peer=(label=systemd-timesyncd),
  # org.freedesktop.timesync1: send and receive anything to the interface on the specific peer label
  dbus (send receive) bus=system path=/org/freedesktop/timesync1{,/**}
       interface=org.freedesktop.timesync1{,.*}
       peer=(name="{@{busname},org.freedesktop.timesync1{,.*},org.freedesktop.DBus}", label=systemd-timesyncd),
  dbus send bus=system path=/org/freedesktop/timesync1{,/**}
       interface=org.freedesktop.timesync1{,.*}
       peer=(name="org.freedesktop.timesync1{,.*}"),
  # DBus.Properties: read and send properties
  dbus (send receive) bus=system path=/org/freedesktop/timesync1{,/**}
       interface=org.freedesktop.DBus.Properties
       member={Get,GetAll,Set,PropertiesChanged}
       peer=(name="{@{busname},org.freedesktop.timesync1{,.*},org.freedesktop.DBus}", label=systemd-timesyncd),
  # DBus.Introspectable: allow service introspection
  dbus send bus=system path=/org/freedesktop/timesync1{,/**}
       interface=org.freedesktop.DBus.Introspectable
       member=Introspect
       peer=(name="{@{busname},org.freedesktop.timesync1{,.*},org.freedesktop.DBus}", label=systemd-timesyncd),
  # DBus.ObjectManager: allow clients to enumerate sources
  dbus send bus=system path=/org/freedesktop/timesync1{,/**}
       interface=org.freedesktop.DBus.ObjectManager
       member=GetManagedObjects
       peer=(name="{@{busname},org.freedesktop.timesync1{,.*},org.freedesktop.DBus}", label=systemd-timesyncd),
  dbus receive bus=system path=/org/freedesktop/timesync1{,/**}
       interface=org.freedesktop.DBus.ObjectManager
       member={InterfacesAdded,InterfacesRemoved}
       peer=(name="{@{busname},org.freedesktop.timesync1{,.*},org.freedesktop.DBus}", label=systemd-timesyncd),


  @{exec_path} mr,

  @{pager_path} rpx -> child-pager,

  include if exists <local/timedatectl>
}

# vim:syntax=apparmor
