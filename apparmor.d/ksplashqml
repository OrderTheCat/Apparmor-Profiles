abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{bin}/ksplashqml
@{att} = /att/ksplashqml/
profile ksplashqml /{,usr/}bin/ksplashqml flags=(attach_disconnected,attach_disconnected.path=@{att},mediate_deleted,complain) {
  include <abstractions/attached/base>
  include <abstractions/bus-session>
  include <abstractions/graphics>
  include <abstractions/kde-strict>
  include <abstractions/attached/nameservice-strict>
  include <abstractions/qt5-shader-cache>

  ptrace read peer=startplasma,

  #aa/dbus own bus=session name=org.kde.KSplash path=/KSplash
  include <abstractions/bus/session/own>
  dbus bind bus=session name=org.kde.KSplash{,.*},
  dbus receive bus=session path=/KSplash
       interface=org.kde.KSplash{,.*}
       peer=(name="@{busname}"),
  dbus send bus=session path=/KSplash
       interface=org.kde.KSplash{,.*}
       peer=(name="{@{busname},org.freedesktop.DBus}"),
  # DBus.Properties: reply to properties request from anyone
  dbus (send receive) bus=session path=/KSplash
       interface=org.freedesktop.DBus.Properties
       member={Get,GetAll,Set,PropertiesChanged}
       peer=(name="{@{busname},org.freedesktop.DBus}"),
  # DBus.Introspectable: allow clients to introspect the service
  dbus receive bus=session path=/KSplash
       interface=org.freedesktop.DBus.Introspectable
       member=Introspect
       peer=(name="@{busname}"),
  # DBus.ObjectManager: allow clients to enumerate sources
  dbus receive bus=session path=/KSplash
       interface=org.freedesktop.DBus.ObjectManager
       member=GetManagedObjects
       peer=(name="{@{busname},org.kde.KSplash{,.*}}"),
  dbus send bus=session path=/KSplash
       interface=org.freedesktop.DBus.ObjectManager
       member={InterfacesAdded,InterfacesRemoved}
       peer=(name="{@{busname},org.freedesktop.DBus}"),


  @{exec_path} mr,

  @{lib}/libheif/            r,
  @{lib}/libheif/*.so*      rm,
  @{bin}/ r,

  /usr/share/color-schemes/* r,
  /usr/share/plasma/** r,

  /etc/machine-id r,
  /etc/xdg/plasmarc r,

  owner @{user_cache_dirs}/ksplash/ rw,
  owner @{user_cache_dirs}/ksplash/** rwlk -> @{user_cache_dirs}/ksplash/**,

  owner @{user_config_dirs}/kdedefaults/ksplashrc r,
  owner @{user_config_dirs}/kdedefaults/plasmarc r,
  owner @{user_config_dirs}/ksplashrc r,
  owner @{user_config_dirs}/plasmarc r,

  include if exists <local/ksplashqml>
}

# vim:syntax=apparmor
