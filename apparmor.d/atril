abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{bin}/atril{,-*}
@{att} = ""
profile atril /{,usr/}bin/atril{,-*} flags=(complain) {
  include <abstractions/base-strict>
  include <abstractions/dconf-write>
  include <abstractions/fontconfig-cache-read>
  include <abstractions/desktop>
  include <abstractions/ibus-strict>
  include <abstractions/nameservice-strict>
  include <abstractions/user-download-strict>

  network netlink raw,

  #aa/dbus talk bus=session name=org.mate.atril.Daemon label=atrild
  # Unix: allow connection to the profile
  unix type=stream peer=(label=atrild),
  # org.mate.atril.Daemon: send and receive anything to the interface on the specific peer label
  dbus (send receive) bus=session path=/org/mate/atril/Daemon{,/**}
       interface=org.mate.atril.Daemon{,.*}
       peer=(name="{@{busname},org.mate.atril.Daemon{,.*},org.freedesktop.DBus}", label=atrild),
  dbus send bus=session path=/org/mate/atril/Daemon{,/**}
       interface=org.mate.atril.Daemon{,.*}
       peer=(name="org.mate.atril.Daemon{,.*}"),
  # DBus.Properties: read and send properties
  dbus (send receive) bus=session path=/org/mate/atril/Daemon{,/**}
       interface=org.freedesktop.DBus.Properties
       member={Get,GetAll,Set,PropertiesChanged}
       peer=(name="{@{busname},org.mate.atril.Daemon{,.*},org.freedesktop.DBus}", label=atrild),
  # DBus.Introspectable: allow service introspection
  dbus send bus=session path=/org/mate/atril/Daemon{,/**}
       interface=org.freedesktop.DBus.Introspectable
       member=Introspect
       peer=(name="{@{busname},org.mate.atril.Daemon{,.*},org.freedesktop.DBus}", label=atrild),
  # DBus.ObjectManager: allow clients to enumerate sources
  dbus send bus=session path=/org/mate/atril/Daemon{,/**}
       interface=org.freedesktop.DBus.ObjectManager
       member=GetManagedObjects
       peer=(name="{@{busname},org.mate.atril.Daemon{,.*},org.freedesktop.DBus}", label=atrild),
  dbus receive bus=session path=/org/mate/atril/Daemon{,/**}
       interface=org.freedesktop.DBus.ObjectManager
       member={InterfacesAdded,InterfacesRemoved}
       peer=(name="{@{busname},org.mate.atril.Daemon{,.*},org.freedesktop.DBus}", label=atrild),


  @{exec_path} mr,

  @{sh_path}             rix,

  @{bin}/atril-previewer rpx,

  @{lib}/{,@{multiarch}/}webkit{2,}gtk-*/WebKitNetworkProcess rix,
  @{lib}/{,@{multiarch}/}webkit{2,}gtk-*/WebKitWebProcess rix,

  /usr/share/atril/{,**} r,

  /etc/fstab r,

  owner @{HOME}/ r,
  owner @{user_documents_dirs}/{,**} rw,
  owner @{user_books_dirs}/{,**} rw,
  owner @{user_torrents_dirs}/{,**} rw,
  owner @{user_work_dirs}/{,**} rw,

  owner @{user_config_dirs}/atril/{,*} rw,

  owner @{user_cache_dirs}/atril/{,**} rw,

  owner @{user_share_dirs}/ r,

  owner @{tmp}/gtkprint_* rw,
  owner @{tmp}/settings*.ini rw,
  owner @{tmp}/settings*.ini.* rw,
  owner @{tmp}/atril-@{pid}/{,**} rw,

  @{sys}/firmware/acpi/pm_profile r,
  @{sys}/devices/virtual/dmi/id/chassis_type r,
  @{sys}/fs/cgroup/** r,

             @{PROC}/zoneinfo r,
       owner @{PROC}/@{pid}/cgroup r,
       owner @{PROC}/@{pid}/fd/ r,
       owner @{PROC}/@{pid}/mountinfo r,
       owner @{PROC}/@{pid}/mounts r,
       owner @{PROC}/@{pid}/statm r,
  deny owner @{PROC}/@{pid}/cmdline r,

  deny owner @{user_share_dirs}/gvfs-metadata/{,*} r,

  include if exists <local/atril>
}

profile @{bin}/atril-previewer flags=(complain) {
  include <abstractions/base-strict>

  include if exists <local/atril-previewer>
}

# vim:syntax=apparmor
