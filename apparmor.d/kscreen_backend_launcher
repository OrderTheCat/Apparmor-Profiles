abi <abi/4.0>,

include <tunables/global>

@{exec_path}  = @{lib}/kf{5,6}/kscreen_backend_launcher
@{exec_path} += @{lib}/@{multiarch}/{,libexec/}kf{5,6}/kscreen_backend_launcher
@{att} = ""
profile kscreen_backend_launcher /{{,usr/}lib{,exec,32,64}/kf{5,6}/kscreen_backend_launcher,{,usr/}lib{,exec,32,64}/*-linux-gnu*/{,libexec/}kf{5,6}/kscreen_backend_launcher,{,usr/}lib{,exec,32,64}/*-linux-gnu*/{,libexec/}kf{5,6}/kscreen_backend_launcher} flags=(complain) {
  include <abstractions/base-strict>
  include <abstractions/kde-strict>

  #aa/dbus own bus=session name=org.kde.KScreen
  include <abstractions/bus/session/own>
  dbus bind bus=session name=org.kde.KScreen{,.*},
  dbus receive bus=session path=/org/kde/KScreen{,/**}
       interface=org.kde.KScreen{,.*}
       peer=(name="@{busname}"),
  dbus send bus=session path=/org/kde/KScreen{,/**}
       interface=org.kde.KScreen{,.*}
       peer=(name="{@{busname},org.freedesktop.DBus}"),
  # DBus.Properties: reply to properties request from anyone
  dbus (send receive) bus=session path=/org/kde/KScreen{,/**}
       interface=org.freedesktop.DBus.Properties
       member={Get,GetAll,Set,PropertiesChanged}
       peer=(name="{@{busname},org.freedesktop.DBus}"),
  # DBus.Introspectable: allow clients to introspect the service
  dbus receive bus=session path=/org/kde/KScreen{,/**}
       interface=org.freedesktop.DBus.Introspectable
       member=Introspect
       peer=(name="@{busname}"),
  # DBus.ObjectManager: allow clients to enumerate sources
  dbus receive bus=session path=/org/kde/KScreen{,/**}
       interface=org.freedesktop.DBus.ObjectManager
       member=GetManagedObjects
       peer=(name="{@{busname},org.kde.KScreen{,.*}}"),
  dbus send bus=session path=/org/kde/KScreen{,/**}
       interface=org.freedesktop.DBus.ObjectManager
       member={InterfacesAdded,InterfacesRemoved}
       peer=(name="{@{busname},org.freedesktop.DBus}"),

  #aa/dbus talk bus=system name=org.kde.kf5auth path=/ label=kde-powerdevil
  # Unix: allow connection to the profile
  unix type=stream peer=(label=kde-powerdevil),
  # org.kde.kf5auth: send and receive anything to the interface on the specific peer label
  dbus (send receive) bus=system path=/
       interface=org.kde.kf5auth{,.*}
       peer=(name="{@{busname},org.kde.kf5auth{,.*},org.freedesktop.DBus}", label=kde-powerdevil),
  dbus send bus=system path=/
       interface=org.kde.kf5auth{,.*}
       peer=(name="org.kde.kf5auth{,.*}"),
  # DBus.Properties: read and send properties
  dbus (send receive) bus=system path=/
       interface=org.freedesktop.DBus.Properties
       member={Get,GetAll,Set,PropertiesChanged}
       peer=(name="{@{busname},org.kde.kf5auth{,.*},org.freedesktop.DBus}", label=kde-powerdevil),
  # DBus.Introspectable: allow service introspection
  dbus send bus=system path=/
       interface=org.freedesktop.DBus.Introspectable
       member=Introspect
       peer=(name="{@{busname},org.kde.kf5auth{,.*},org.freedesktop.DBus}", label=kde-powerdevil),
  # DBus.ObjectManager: allow clients to enumerate sources
  dbus send bus=system path=/
       interface=org.freedesktop.DBus.ObjectManager
       member=GetManagedObjects
       peer=(name="{@{busname},org.kde.kf5auth{,.*},org.freedesktop.DBus}", label=kde-powerdevil),
  dbus receive bus=system path=/
       interface=org.freedesktop.DBus.ObjectManager
       member={InterfacesAdded,InterfacesRemoved}
       peer=(name="{@{busname},org.kde.kf5auth{,.*},org.freedesktop.DBus}", label=kde-powerdevil),


  @{exec_path} mr,

  /dev/tty r,

  include if exists <local/kscreen_backend_launcher>
}

# vim:syntax=apparmor
