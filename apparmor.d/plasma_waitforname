abi <abi/4.0>,

include <tunables/global>

@{exec_path} = @{bin}/plasma_waitforname
@{att} = /att/plasma_waitforname/
profile plasma_waitforname /{,usr/}bin/plasma_waitforname flags=(attach_disconnected,attach_disconnected.path=@{att},complain) {
  include <abstractions/attached/base>
  include <abstractions/bus-session>
  include <abstractions/attached/consoles>
  include <abstractions/qt5>

  @{exec_path} mr,

  include if exists <local/plasma_waitforname>
}

# vim:syntax=apparmor
